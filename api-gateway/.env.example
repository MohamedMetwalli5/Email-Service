# Example api-gateway .env (IntelliJ run config "ApiGatewayApplication").
# Copy this file to ".env" in the api-gateway/ directory and fill in real values.
# No active profile needed (gateway uses application.yml, no profile siblings).

# ── CORS ───────────────────────────────────────────────
CORS_ALLOWED_ORIGIN=http://localhost:8080

# ── Downstream services (host ports when running from IntelliJ) ──
AUTH_SERVICE_URL=http://localhost:8082
MAIL_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084