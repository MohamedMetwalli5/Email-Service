# Example notification-service .env (IntelliJ run config "NotificationServiceApplication").
# Copy this file to ".env" in the notification-service/ directory and fill in real values.

# ── notification-service database (scoped MySQL user created by db/init/01-schemas.sh) ──
DB_NAME=seamail_notifications
DB_USER=seamail_notification_user
DB_PASSWORD=your_notification_db_password

# ── Kafka ───────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── auth-service (JWKS) ─────────────────────────────────
JWKS_URI=http://localhost:8082/.well-known/jwks.json