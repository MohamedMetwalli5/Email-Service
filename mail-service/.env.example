# Example mail-service .env (IntelliJ run config "MailServiceApplication").
# Copy this file to ".env" in the mail-service/ directory and fill in real values.

# ── mail-service database (scoped MySQL user created by db/init/01-schemas.sh) ──
DB_NAME=seamail_mail
DB_USER=seamail_mail_user
DB_PASSWORD=your_mail_db_password

# ── Redis (Docker local container) ──────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ── auth-service (Feign receiver check + JWKS) ─────────
AUTH_SERVICE_URL=http://localhost:8082
JWKS_URI=http://localhost:8082/.well-known/jwks.json

# ── Kafka ───────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092