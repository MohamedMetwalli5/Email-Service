# Example auth-service .env (IntelliJ run config "AuthServiceApplication").
# Copy this file to ".env" in the auth-service/ directory and fill in real values.

# ── auth-service database (scoped MySQL user created by db/init/01-schemas.sh) ──
DB_NAME=seamail_auth
DB_USER=seamail_auth_user
DB_PASSWORD=your_auth_db_password

# ── Redis (Docker local container, no auth) ─────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# ── JWT signing (empty = ephemeral keypair generated at startup; not safe for shared use) ──
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# ── CORS ───────────────────────────────────────────────
CORS_ALLOWED_ORIGIN=http://localhost:8080

# ── Discord OAuth2 ─────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:8081/api/v1/auth/discord